<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup and device transfer from Android 12. "device" holds the installation id, which
     must not move to another phone (see AppSettings.deviceId). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="device.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="device.xml" />
    </device-transfer>
</data-extraction-rules>
